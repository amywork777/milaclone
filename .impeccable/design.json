      "description": "Accent selection and subdued completion.",
      "html": "<label class=\"ds-task\"><input type=\"checkbox\"><span>Give a thought a home</span></label>",
      "css": ".ds-task{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.6;color:#3c3f45}.ds-task input{appearance:none;position:relative;width:17px;height:17px;border:1.6px solid #cfd2d8;border-radius:5px;margin:1px 0 0;cursor:pointer}.ds-task input:checked{background:var(--accent,#79576e);border-color:var(--accent,#79576e)}.ds-task input:checked:after{content:\"\";position:absolute;left:5px;top:1px;width:4px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}.ds-task input:checked+span{color:var(--ink-faint,#817982);text-decoration:line-through}.ds-task input:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}"

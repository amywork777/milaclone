  "components": [
    {
      "name": "Confirmation button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Plum confirmation in a dialog.",
      "html": "<button class=\"ds-confirm\">Create board</button>",
      "css": ".ds-confirm{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);color:#fff;background:var(--accent,#79576e);border:1px solid var(--accent,#79576e);border-radius:5px;padding:8px 13px;cursor:pointer;transition:background .12s}.ds-confirm:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}.ds-confirm:disabled{opacity:.35;cursor:default}"
    },
    {
      "name": "Tidy up",
      "kind": "button",
      "refersTo": "button-organize",
      "description": "Quiet arrangement action alongside history and fit.",
      "html": "<button class=\"ds-tidy\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Tidy up</button>",
      "css": ".ds-tidy{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);display:flex;align-items:center;gap:7px;border:1px solid var(--rail-border,#e3dfdc);background:#fdfcfa;border-radius:5px;padding:7px 9px;font-size:11px;min-height:32px;cursor:pointer;transition:background .12s}.ds-tidy:hover{background:#eee9ed}.ds-tidy:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}"
    },
    {
      "name": "Dialog input",
      "kind": "input",
      "refersTo": "input",
      "description": "Search and board creation field.",
      "html": "<input class=\"ds-input\" aria-label=\"Board name\" placeholder=\"What are you thinking about?\">",
      "css": ".ds-input{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);width:calc(100% - 24px);padding:11px;border:1px solid var(--rail-border,#e3dfdc);border-radius:5px;font-size:14px;background:#fff;caret-color:var(--accent,#79576e)}.ds-input:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}"
    },
    {
      "name": "Board navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Nested board list with a quiet current state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Your boards\"><button aria-current=\"page\">My workspace</button><button class=\"ds-child\">Weekend ideas</button></nav>",
      "css": ".ds-nav{width:185px}.ds-nav button{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);display:block;width:100%;border:0;border-radius:6px;background:transparent;color:var(--ink,#302e32);min-height:34px;padding:8px 9px;margin:1px 0;text-align:left;font-size:12px;cursor:pointer}.ds-nav button[aria-current]{background:#eae4e9;color:#62475b}.ds-nav button:hover{background:#eee9ed}.ds-nav button:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}.ds-nav .ds-child{padding-left:22px}"
    },
    {
      "name": "Note card",
      "kind": "card",
      "refersTo": "note-card",
      "description": "White material carrying a short title and thought.",
      "html": "<article class=\"ds-note\" tabindex=\"0\"><h3>A small reminder</h3><p>Not every idea needs to become a project.</p></article>",
      "css": ".ds-note{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);width:210px;padding:14px 16px;background:var(--card-bg,#fff);color:var(--ink,#302e32);border:1px solid #dfdadd;border-radius:var(--radius,6px);box-shadow:var(--card-shadow,0 2px 6px #392d3910,0 12px 24px -20px #392d3940)}.ds-note h3{font-size:14px;font-weight:550;margin:0 0 4px}.ds-note p{font-size:13px;line-height:1.6;color:#3c3f45;margin:0}.ds-note:hover{box-shadow:var(--card-shadow,0 2px 6px #392d3910)}.ds-note:focus-visible{outline:2px solid var(--accent,#79576e);outline-offset:3px;}"
    },
    {
      "name": "Column",
      "kind": "custom",
      "refersTo": "column",
      "description": "Flat grouping surface with a small color marker.",
      "html": "<section class=\"ds-column\"><h3><span></span>Things to keep</h3><div class=\"ds-column-card\">A note, a reference, a thought.</div></section>",
      "css": ".ds-column{font-family:var(--sans,\"Helvetica Neue\",Helvetica,Arial,sans-serif);width:250px;padding:14px 12px;background:#eae7e387;border-radius:5px;color:var(--ink,#302e32)}.ds-column h3{display:flex;align-items:center;gap:8px;margin:2px 4px 15px;font-size:13px;font-weight:550}.ds-column h3 span{width:6px;height:6px;border-radius:50%;background:var(--c-green,#8ca884)}.ds-column-card{padding:14px 16px;font-size:13px;line-height:1.6;background:#fff;border-radius:6px;box-shadow:var(--card-shadow,0 2px 6px #392d3910)}"
